# ====================================================================
# Saras Dynamics AI Voice Agent - Environment Configuration
# Company: Saras Dynamics (https://www.sarasdynamics.com/)
# ====================================================================

# 1. OpenAI Realtime API Credentials (REQUIRED FOR PRODUCTION VOICE)
# Your OpenAI API key starting with 'sk-...'
# Kept securely on backend; never exposed to browser client or bundle.
OPENAI_API_KEY="sk-your-openai-api-key-here"

# Model identifier for OpenAI Realtime voice API
# Supported models: gpt-realtime, gpt-4o-realtime-preview, gpt-4o-mini-realtime-preview
OPENAI_REALTIME_MODEL="gpt-realtime"

# Voice persona (Warm, articulate Indian English)
# Supported options: coral, alloy, shimmer, echo, sage, verse, ballad, ash
OPENAI_REALTIME_VOICE="coral"

# Server-side Voice Activity Detection sensitivity (0.5 to 0.95)
OPENAI_VAD_THRESHOLD=0.78

# 2. Database & Persistent Vector Storage (PostgreSQL + pgvector)
# Optional in development (defaults to zero-dependency in-memory vector engine).
# Required in production for persistent leads, website chunks, and call logs.
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/saras_dynamics_voice"

# 3. Server & Networking
PORT=5000
APP_URL="http://localhost:5000"
NODE_ENV="development"

# 4. Optional Telephony Carrier / SIP Gateway (Twilio / SIP Trunking)
TELEPHONY_PROVIDER="TWILIO_MEDIA_STREAM"
TELEPHONY_PHONE_NUMBER="+918040008888"
TELEPHONY_WEBHOOK_SECRET="your-telephony-webhook-hmac-auth-secret"

# 5. Administrative Security & Staff Provisioning
INITIAL_ADMIN_PASSWORD="Saras_SuperAdmin@2026!"
INITIAL_SALES_PASSWORD="Saras_SalesLead@2026!"
INITIAL_ENGINEER_PASSWORD="Saras_AiEng@2026!"
INITIAL_AUDITOR_PASSWORD="Saras_Auditor@2026!"

# Strict Authentication Enforcement flag ('true' in production)
STRICT_AUTH="false"
